async function updateSellerOrder(orderId, changes, message){
    try{
        const result = await db
            .from("store_orders")
            .update({
                ...changes,
                updated_at: new Date().toISOString()
            })
            .eq("id", orderId)
            .eq("seller_id", sellerProfile.id)
            .select("id")
            .maybeSingle();

        if(result.error) throw result.error;
        if(!result.data) throw new Error("Order update not permitted.");

        alert(message);
        await loadOrders();

    }catch(error){
        alert("Update failed: " + error.message);
    }
}

async function verifyOrderPayment(orderId, decision){
    const question = decision === "verified"
        ? "Have you checked your bank/UPI and confirmed payment received?"
        : "Are you sure you want to reject this payment?";

    if(!confirm(question)) return;

    const changes = {payment_status: decision};

    if(decision === "rejected"){
        changes.order_status = "cancelled";
    }

    await updateSellerOrder(
        orderId,
        changes,
        decision === "verified"
            ? "Payment verified successfully."
            : "Payment rejected."
    );
}

async function updateOrderDecision(orderId, decision){
    if(!confirm(
        decision === "accepted"
            ? "Accept this customer order?"
            : "Reject this customer order?"
    )) return;

    await updateSellerOrder(
        orderId,
        {
            order_status: decision === "accepted"
                ? "accepted"
                : "cancelled"
        },
        decision === "accepted"
            ? "Order accepted."
            : "Order rejected."
    );
}

async function saveOrderTracking(orderId){
    const field = document.getElementById("tracking_" + orderId);
    const details = field ? field.value.trim() : "";
    const words = details.match(/\S+/g) || [];

    if(words.length > 70){
        alert("Maximum 70 words allowed.");
        return;
    }

    await updateSellerOrder(
        orderId,
        {tracking_details: details},
        "Tracking details saved."
    );
}

async function loadOrders(){
    const tbody = document.getElementById("ordersTable");

    if(!tbody || !sellerProfile) return;

    tbody.innerHTML =
        "<tr><td colspan='9'>Loading orders...</td></tr>";

    try{
        const result = await db
            .from("store_orders")
            .select("id,order_number,seller_id,customer_name,customer_mobile,delivery_address,pin_code,subtotal,payment_utr,payment_status,order_status,tracking_details,created_at")
            .eq("seller_id", sellerProfile.id)
            .order("created_at", {ascending:false});

        if(result.error) throw result.error;

        const orders = result.data || [];

        if(orders.length === 0){
            tbody.innerHTML =
                "<tr><td colspan='9'>No customer orders found.</td></tr>";
            return;
        }

        const orderIds = orders.map(function(order){
            return order.id;
        });

        const itemsResult = await db
            .from("store_order_items")
            .select("order_id,product_name,quantity,unit_price")
            .in("order_id", orderIds);

        if(itemsResult.error) throw itemsResult.error;

        const items = itemsResult.data || [];

        tbody.innerHTML = orders.map(function(order){

            const id = escapeHtml(order.id);

            const orderItems = items.filter(function(item){
                return item.order_id === order.id;
            });

            const products = orderItems.map(function(item){
                return escapeHtml(item.product_name) +
                    " (₹" + Number(item.unit_price || 0).toFixed(2) + ")";
            }).join("<br>") || "-";

            const quantities = orderItems.map(function(item){
                return escapeHtml(item.quantity);
            }).join("<br>") || "-";

            const address =
                (order.delivery_address || "") +
                (order.pin_code ? ", PIN: " + order.pin_code : "");

            const payment =
                String(order.payment_status || "pending").toLowerCase();

            const status =
                String(order.order_status || "pending").toLowerCase();

            let paymentActions = "";

            if(payment === "pending"){
                paymentActions =
                    "<br><button onclick=\"verifyOrderPayment('" +
                    id + "','verified')\">Verify Payment</button>" +
                    " <button class='logout' onclick=\"verifyOrderPayment('" +
                    id + "','rejected')\">Reject Payment</button>";
            }

            let orderActions = "";

            if(status === "pending" && payment === "verified"){
                orderActions =
                    "<br><button onclick=\"updateOrderDecision('" +
                    id + "','accepted')\">Accept Order</button>" +
                    " <button class='logout' onclick=\"updateOrderDecision('" +
                    id + "','rejected')\">Reject Order</button>";
            }else if(status === "pending"){
                orderActions =
                    "<br><small>Verify payment before accepting.</small>";
            }

            const tracking =
                "<br><textarea id='tracking_" + id +
                "' rows='3' placeholder='Courier name, tracking number and website. Maximum 70 words'>" +
                escapeHtml(order.tracking_details || "") +
                "</textarea>" +
                "<button onclick=\"saveOrderTracking('" + id +
                "')\">Save Tracking Details</button>";

            const date = order.created_at
                ? new Date(order.created_at).toLocaleString("en-IN")
                : "-";

            return "<tr>" +
                "<td>" + escapeHtml(order.order_number || "-") +
                "<br><small>" + escapeHtml(date) + "</small></td>" +
                "<td>" + products + "</td>" +
                "<td>" + quantities + "</td>" +
                "<td>" + escapeHtml(order.customer_name || "-") + "</td>" +
                "<td>" + escapeHtml(order.customer_mobile || "-") + "</td>" +
                "<td>" + escapeHtml(address || "-") + "</td>" +
                "<td>₹" + Number(order.subtotal || 0).toFixed(2) + "</td>" +
                "<td>" + escapeHtml(payment) +
                (order.payment_utr
                    ? "<br>UTR: " + escapeHtml(order.payment_utr)
                    : "") +
                paymentActions + "</td>" +
                "<td>" + escapeHtml(status) +
                orderActions + tracking + "</td>" +
                "</tr>";

        }).join("");

    }catch(error){
        tbody.innerHTML =
            "<tr><td colspan='9'>Could not load orders: " +
            escapeHtml(error.message) +
            "</td></tr>";
    }
}

async function savePaymentDetails(){
    if(!currentUser || !sellerProfile) return;

    const upi = document.getElementById("sellerUpi").value.trim();
    const file = document.getElementById("qrFile").files[0];

    if(!upi){
        showMessage("qrMessage","Please enter your UPI ID.");
        return;
    }

    let qrUrl = sellerProfile.payment_qr_url || null;

    try{
        if(file){
            if(!file.type.startsWith("image/")){
                throw new Error("Please select an image file.");
            }

            const ext = file.name.split(".").pop().toLowerCase();
            const path = currentUser.id + "/payment-qr-" + Date.now() + "." + ext;

            const upload = await db.storage
                .from("seller-qr")
                .upload(path,file,{upsert:false});

            if(upload.error) throw upload.error;

            const urlResult = db.storage
                .from("seller-qr")
                .getPublicUrl(path);

            qrUrl = urlResult.data.publicUrl;
        }

        const update = await db
            .from("seller_profiles")
            .update({
                payment_upi_id:upi,
                payment_qr_url:qrUrl
            })
            .eq("id",sellerProfile.id);

        if(update.error) throw update.error;

        sellerProfile.payment_upi_id = upi;
        sellerProfile.payment_qr_url = qrUrl;

        if(qrUrl){
            document.getElementById("qrPreview").src = qrUrl;
            document.getElementById("qrPreview").style.display = "block";
        }

        showMessage("qrMessage","Payment details saved successfully.",true);

    }catch(error){
        showMessage("qrMessage","Save failed: " + error.message);
    }
}

document.getElementById("qrFile").addEventListener("change",function(){
    const file = this.files[0];

    if(file){
        if(!file.type.startsWith("image/")){
            showMessage("qrMessage","Please select an image file.");
            this.value = "";
            return;
        }

        document.getElementById("qrPreview").src = URL.createObjectURL(file);
        document.getElementById("qrPreview").style.display = "block";
    }
});

document.getElementById("productForm").addEventListener("submit",async function(e){
    e.preventDefault();

    if(!currentUser || !sellerProfile) return;

    if(String(sellerProfile.status).toLowerCase() !== "approved"){
        showMessage("uploadMessage","Your seller account is not approved yet.");
        return;
    }

    const name = document.getElementById("productName").value.trim();
    const description = document.getElementById("productDescription").value.trim();
    const category = document.getElementById("productCategory").value.trim();
    const price = Number(document.getElementById("productPrice").value);
    const stock = Number(document.getElementById("productStock").value);
    const utr = document.getElementById("utrNumber").value.trim();
    const imageFile = document.getElementById("productImage").files[0];

    if(!name || !description || !category || !imageFile || !utr){
        showMessage("uploadMessage","Please complete all fields.");
        return;
    }

    if(!Number.isFinite(price) || price <= 0){
        showMessage("uploadMessage","Enter a valid product price.");
        return;
    }

    if(!Number.isInteger(stock) || stock < 10){
        showMessage("uploadMessage","Initial stock must be at least 10.");
        return;
    }

    if(utr.length < 6){
        showMessage("uploadMessage","Please enter a valid UTR / transaction number.");
        return;
    }

    if(!imageFile.type.startsWith("image/")){
        showMessage("uploadMessage","Please select a valid product image.");
        return;
    }

    const button = document.getElementById("uploadBtn");
    button.disabled = true;
    button.textContent = "Submitting...";

    let paymentCreated = false;

    try{
        const imageExt = imageFile.name.split(".").pop().toLowerCase();
        const imagePath = currentUser.id + "/" + Date.now() + "-" + Math.random().toString(36).slice(2) + "." + imageExt;

        const imageUpload = await db.storage
            .from("images")
            .upload(imagePath,imageFile,{upsert:false});

        if(imageUpload.error) throw new Error("Product image upload failed: " + imageUpload.error.message);

        const imageResult = db.storage
            .from("images")
            .getPublicUrl(imagePath);

        const imageUrl = imageResult.data.publicUrl;

        const paymentResult = await db
            .from("seller_upload_payments")
            .insert({
                seller_id:currentUser.id,
                amount:20,
                upi_id:"beingbimalvicky@ybl",
                utr_number:utr,
                status:"pending",
                payment_type:"product_upload",
                product_count:1,
                approved_count:0
            })
            .select("id")
            .single();

        if(paymentResult.error) throw new Error("Payment record failed: " + paymentResult.error.message);

        paymentCreated = true;

        const productResult = await db
            .from("seller_products")
            .insert({
                seller_id:sellerProfile.id,
                name:name,
                description:description,
                price:price,
                image_url:imageUrl,
                category:category,
                stock:stock,
                status:"pending",
                upload_payment_id:paymentResult.data.id
            });

        if(productResult.error){
            throw new Error("Payment record created, but product save failed. Contact Admin with UTR: " + utr + ". Error: " + productResult.error.message);
        }

        showMessage("uploadMessage","Product submitted. Payment verification and product approval are pending.",true);

        document.getElementById("productForm").reset();
        document.getElementById("productStock").value = 10;

        await loadProducts();
        await loadPayments();

    }catch(error){
        showMessage("uploadMessage",error.message);

        if(paymentCreated){
            showMessage("uploadMessage",error.message + " Your payment record may already exist. Do not submit again until checking the payment list.");
        }

    }finally{
        button.disabled = false;
        button.textContent = "Submit Product";
    }
});

async function loadProducts(){
    const tbody = document.getElementById("productsTable");
    tbody.innerHTML = "<tr><td colspan='5'>Loading...</td></tr>";

    const result = await db
        .from("seller_products")
        .select("id,name,price,stock,status,upload_payment_id")
        .eq("seller_id",sellerProfile.id)
        .order("created_at",{ascending:false});

    if(result.error){
        tbody.innerHTML = "<tr><td colspan='5'>Error: " + escapeHtml(result.error.message) + "</td></tr>";
        return;
    }

    const products = result.data || [];

    if(products.length === 0){
        tbody.innerHTML = "<tr><td colspan='5'>No products uploaded yet.</td></tr>";
        return;
    }

    const paymentIds = [...new Set(products.map(function(p){
        return p.upload_payment_id;
    }).filter(Boolean))];

    let paymentMap = {};

    if(paymentIds.length > 0){
        const paymentResult = await db
            .from("seller_upload_payments")
            .select("id,status")
            .in("id",paymentIds);

        if(paymentResult.error){
            tbody.innerHTML = "<tr><td colspan='5'>Payment status error: " + escapeHtml(paymentResult.error.message) + "</td></tr>";
            return;
        }

        (paymentResult.data || []).forEach(function(p){
            paymentMap[p.id] = p.status;
        });
    }

    tbody.innerHTML = products.map(function(p){
        return "<tr>" +
            "<td>" + escapeHtml(p.name) + "</td>" +
            "<td>₹" + Number(p.price).toFixed(2) + "</td>" +
            "<td>" + escapeHtml(p.stock) + "</td>" +
          "<td class='status'>" + escapeHtml(p.status || "pending") + "</td>" +
            "<td class='status'>" + escapeHtml(paymentMap[p.upload_payment_id] || "pending") + "</td>" +
            "</tr>";
    }).join("");
}

async function loadPayments(){
    const tbody = document.getElementById("paymentsTable");
    tbody.innerHTML = "<tr><td colspan='5'>Loading...</td></tr>";

    const result = await db
        .from("seller_upload_payments")
        .select("id,amount,product_count,utr_number,status,created_at,payment_type")
        .eq("seller_id",currentUser.id)
        .eq("payment_type","product_upload")
        .order("created_at",{ascending:false});

    if(result.error){
        tbody.innerHTML = "<tr><td colspan='5'>Error: " + escapeHtml(result.error.message) + "</td></tr>";
        return;
    }

    const payments = result.data || [];

    if(payments.length === 0){
        tbody.innerHTML = "<tr><td colspan='5'>No product upload payments yet.</td></tr>";
        return;
    }

    tbody.innerHTML = payments.map(function(p){
        const date = p.created_at
            ? new Date(p.created_at).toLocaleDateString("en-IN")
            : "-";

        return "<tr>" +
            "<td>" + escapeHtml(date) + "</td>" +
            "<td>" + escapeHtml(p.product_count) + "</td>" +
            "<td>₹" + escapeHtml(p.amount) + "</td>" +
            "<td>" + escapeHtml(p.utr_number || "-") + "</td>" +
            "<td class='status'>" + escapeHtml(p.status || "pending") + "</td>" +
            "</tr>";
    }).join("");
}

async function checkSession(){
    if(!db) return;

    try{
        const result = await db.auth.getSession();

        if(result.error) throw result.error;

        if(result.data.session){
            await loadDashboard(result.data.session.user);
        }

    }catch(error){
        showMessage("loginMessage","Session error: " + error.message);
    }
}

function initializeDashboard(){
    if(!window.supabase || !window.supabase.createClient){
        showMessage("loginMessage","Supabase library could not load. Check your internet connection.");
        return;
    }

    db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
    checkSession();
}

window.login = login;
window.logout = logout;

initializeDashboard();
</script>
