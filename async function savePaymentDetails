function showMessage(id,message,success=false){
    const el = document.getElementById(id);
    if(!el) return;
    el.textContent = message;
    el.className = success ? "green" : "red";
}

function escapeHtml(value){
    return String(value ?? "").replace(/[&<>"']/g,function(ch){
        return {
            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
            "'":"&#039;"
        }[ch];
    });
}

async function login(){
    if(!db){
        showMessage("loginMessage","Supabase connection is not available.");
        return;
    }

    const email = document.getElementById("loginEmail").value.trim();
    const password = document.getElementById("loginPassword").value;
    const button = document.getElementById("loginBtn");

    if(!email || !password){
        showMessage("loginMessage","Enter email and password.");
        return;
    }

    button.disabled = true;
    button.textContent = "Signing in...";
    showMessage("loginMessage","Please wait...",true);

    try{
        const result = await db.auth.signInWithPassword({
            email:email,
            password:password
        });

        if(result.error) throw result.error;

        await loadDashboard(result.data.user);

    }catch(error){
        showMessage("loginMessage","Login failed: " + error.message);
    }finally{
        button.disabled = false;
        button.textContent = "Login";
    }
}

async function logout(){
    if(!db) return;

    const result = await db.auth.signOut();

    if(result.error){
        alert("Logout error: " + result.error.message);
        return;
    }

    currentUser = null;
    sellerProfile = null;

    document.getElementById("dashboard").style.display = "none";
    document.getElementById("loginBox").style.display = "block";
    document.getElementById("logoutBtn").style.display = "none";
    document.getElementById("loginPassword").value = "";

    showMessage("loginMessage","Logged out successfully.",true);
}

async function loadDashboard(user){
    currentUser = user;

    try{
        const result = await db
            .from("seller_profiles")
            .select("id,full_name,shop_name,status,business_address,payment_upi_id,payment_qr_url")
            .eq("id",user.id)
            .single();

        if(result.error) throw result.error;
        if(!result.data) throw new Error("Seller profile not found.");

        sellerProfile = result.data;

        document.getElementById("loginBox").style.display = "none";
        document.getElementById("dashboard").style.display = "block";
        document.getElementById("logoutBtn").style.display = "block";

        document.getElementById("sellerName").textContent = sellerProfile.full_name || "-";
        document.getElementById("shopName").textContent = sellerProfile.shop_name || "-";
        document.getElementById("sellerStatus").textContent = sellerProfile.status || "-";
        document.getElementById("sellerUpi").value = sellerProfile.payment_upi_id || "";

        if(sellerProfile.payment_qr_url){
            document.getElementById("qrPreview").src = sellerProfile.payment_qr_url;
            document.getElementById("qrPreview").style.display = "block";
        }

        await loadOrders();
        await loadProducts();
        await loadPayments();

    }catch(error){
        showMessage("loginMessage","Dashboard error: " + error.message);
        await db.auth.signOut();
        currentUser = null;
        sellerProfile = null;
        document.getElementById("dashboard").style.display = "none";
        document.getElementById("loginBox").style.display = "block";
        document.getElementById("logoutBtn").style.display = "none";
    }
}

